{
    "name": "fabpot/amphp-sqlite3",
    "description": "Asynchronous SQLite client for PHP based on Amp.",
    "keywords": [
        "database",
        "db",
        "sqlite",
        "asynchronous",
        "async"
    ],
    "homepage": "https://github.com/fabpot/amp-sqlite3",
    "license": "MIT",
    "authors": [
        {
            "name": "Fabien Potencier",
            "email": "fabien@potencier.org"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-sqlite3": "*",
        "amphp/amp": "^3.1.1",
        "amphp/byte-stream": "^2",
        "amphp/parallel": "^2",
        "amphp/sql": "^2.0.1",
        "amphp/sql-common": "^2.0.4",
        "amphp/sync": "^2",
        "revolt/event-loop": "^1.0.8"
    },
    "conflict": {
        "amphp/dns": "<2.1.2",
        "amphp/process": "<2.0.3",
        "amphp/socket": "<2.3.1"
    },
    "require-dev": {
        "amphp/php-cs-fixer-config": "^2",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.2"
    },
    "autoload": {
        "psr-4": {
            "Fabpot\\Amp\\Sqlite\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fabpot\\Amp\\Sqlite\\Test\\": "tests"
        }
    },
    "scripts": {
        "check": [
            "@cs",
            "@phpstan",
            "@test"
        ],
        "cs": "php-cs-fixer fix --show-progress=none --diff --dry-run",
        "cs-fix": "php-cs-fixer fix --show-progress=none --diff",
        "phpstan": "@php ./vendor/bin/phpstan analyse --no-progress",
        "test": "@php -dzend.assertions=1 -dassert.exception=1 ./vendor/bin/phpunit"
    }
}
